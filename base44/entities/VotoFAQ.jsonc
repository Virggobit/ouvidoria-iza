{
  "name": "VotoFAQ",
  "type": "object",
  "properties": {
    "faq_id": {
      "type": "string",
      "description": "ID da FAQ votada"
    },
    "util": {
      "type": "boolean",
      "description": "Se votou como \u00fatil (true) ou n\u00e3o \u00fatil (false)"
    },
    "ip_hash": {
      "type": "string",
      "description": "Hash do IP para evitar m\u00faltiplos votos"
    },
    "email_usuario": {
      "type": "string",
      "description": "Email do usu\u00e1rio que votou (se logado)"
    }
  },
  "required": [
    "faq_id",
    "util"
  ]
}