{
  "name": "SugestaoMelhoria",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "ux",
        "acessibilidade",
        "bug",
        "melhoria_triagem",
        "integracao_iza"
      ],
      "description": "Tipo da sugest\u00e3o de melhoria"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada da sugest\u00e3o"
    },
    "pagina_tela": {
      "type": "string",
      "description": "P\u00e1gina ou tela relacionada (opcional)"
    },
    "canal": {
      "type": "string",
      "enum": [
        "text",
        "audio",
        "video"
      ],
      "default": "text",
      "description": "Canal utilizado para enviar a sugest\u00e3o"
    },
    "audio_url": {
      "type": "string",
      "description": "URL do \u00e1udio da sugest\u00e3o"
    },
    "video_url": {
      "type": "string",
      "description": "URL do v\u00eddeo da sugest\u00e3o"
    },
    "consentimento_lgpd": {
      "type": "boolean",
      "default": false,
      "description": "Confirma\u00e7\u00e3o de que n\u00e3o incluir\u00e1 dados pessoais sens\u00edveis"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_analise",
        "implementada",
        "rejeitada"
      ],
      "default": "pendente",
      "description": "Status da sugest\u00e3o"
    }
  },
  "required": [
    "tipo",
    "descricao",
    "consentimento_lgpd"
  ]
}